# Production (docker-compose.prod.yml reads this file as .env.production):
# DOMAIN=tghub.tn
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/tghub
# 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated origins allowed to call the API directly (the web app proxies through /api/v1).
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
# Poll enabled alert sources (Steam News) and tournament sources on their interval.
INGESTION_ENABLED=false
# Tournament platforms (consumed, never created on TG Hub). Leave empty to disable a provider.
#   start.gg: developer token from https://start.gg/admin/profile/developer
#   FACEIT:   server-side Data API key from https://developers.faceit.com
START_GG_TOKEN=
FACEIT_API_KEY=
# Uploaded images (listing photos, avatars, covers) go to Cloudflare R2 when the R2 values
# below are set (account id or endpoint, key pair, bucket), and to MEDIA_DIR on local disk
# when they're all empty.
# Relative paths resolve from apps/api.
MEDIA_DIR=var/media
MEDIA_MAX_UPLOAD_MB=8
#   R2: Cloudflare dashboard → R2 → create a bucket, then "Manage API tokens" → token with
#   Object Read & Write on that bucket. The account id is on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public address of the bucket (custom domain such as https://media.tghub.tn, or the r2.dev URL
# for testing). Empty = images are streamed through the API instead.
R2_PUBLIC_URL=
# S3 endpoint, https://<account id>.r2.cloudflarestorage.com — can replace R2_ACCOUNT_ID.
# EU-jurisdiction buckets: https://<account id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
# Folder inside the bucket, so TG Hub can share a bucket with other projects.
R2_PREFIX=tg-hub
# Outgoing mail (sign-up codes, password resets, security notices, welcome), e.g.
#   Brevo: smtp://LOGIN:SMTP_KEY@smtp-relay.brevo.com:587
#   Gmail: smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465  (a Google app password without spaces;
#          MAIL_FROM must use the same Gmail address; Gmail allows about 500 emails a day)
# Write @ inside the login as %40. Leave empty in development: emails go to the API log and codes show on the verify page.
SMTP_URL=
MAIL_FROM=TG Hub <no-reply@tghub.tn>
# Web push (phone/desktop notifications). Generate with: npx web-push generate-vapid-keys
# Leave blank in development: the API creates a key pair in var/vapid-dev.json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@tghub.tn
# Public URL of the web app (OAuth callbacks, links in bot replies).
PUBLIC_WEB_URL=http://localhost:3000
# Discord sign-in + bot. Redirect URI to register in the Discord portal:
#   <PUBLIC_WEB_URL>/api/v1/auth/discord/callback
# Interactions endpoint URL: <PUBLIC_WEB_URL>/api/v1/discord/interactions
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Steam Web API key (https://steamcommunity.com/dev/apikey) — optional, enables owned-games sync.
STEAM_API_KEY=
# IGDB (via Twitch) — the game catalogue's data: descriptions, dates, companies, platforms,
# modes, covers, screenshots, trailers, ratings. Register an app at https://dev.twitch.tv/console.
# With the client secret, the server fetches and renews tokens itself (recommended);
# IGDB_TOKEN ("Bearer …") works instead but expires after about 60 days.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
IGDB_TOKEN=
# Featured listings. Leave PAYMENT_PROVIDER empty to pick automatically:
# Flouci if its keys are set, then Konnect, then a local test checkout (development only).
PAYMENT_PROVIDER=
# Flouci (https://docs.flouci.com): keys of your app; use the TEST APP keys while testing.
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=
# Konnect (https://docs.konnect.network): API key + the wallet that receives payments.
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_SANDBOX=true
LOG_LEVEL=info
# Dev seed accounts (npm run seed). Local only.
SEED_ADMIN_PASSWORD=tghub-admin-dev
SEED_PLAYER_PASSWORD=tghub-player-dev
SEED_FETCH_FEEDS=true
