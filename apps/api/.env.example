# Production (docker-compose.prod.yml reads this file as .env.production):
# DOMAIN=tghub.tn
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/tghub
# 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated origins allowed to call the API directly (the web app proxies through /api/v1).
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
# Poll enabled alert sources (Steam News) and tournament sources on their interval.
INGESTION_ENABLED=false
# Tournament platforms (consumed, never created on TG Hub). Leave empty to disable a provider.
#   start.gg: developer token from https://start.gg/admin/profile/developer
#   FACEIT:   server-side Data API key from https://developers.faceit.com
START_GG_TOKEN=
FACEIT_API_KEY=
# Marketplace photos (local disk driver). Relative paths resolve from apps/api.
MEDIA_DIR=var/media
MEDIA_MAX_UPLOAD_MB=8
# Outgoing mail for sign-up verification codes, e.g. smtp://user:pass@smtp-relay.brevo.com:587
# Leave empty in development: codes are written to the API log and shown on the verify page.
SMTP_URL=
MAIL_FROM=TG Hub <no-reply@tghub.tn>
# Web push (phone/desktop notifications). Generate with: npx web-push generate-vapid-keys
# Leave blank in development: the API creates a key pair in var/vapid-dev.json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@tghub.tn
# Public URL of the web app (OAuth callbacks, links in bot replies).
PUBLIC_WEB_URL=http://localhost:3000
# Discord sign-in + bot. Redirect URI to register in the Discord portal:
#   <PUBLIC_WEB_URL>/api/v1/auth/discord/callback
# Interactions endpoint URL: <PUBLIC_WEB_URL>/api/v1/discord/interactions
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Steam Web API key (https://steamcommunity.com/dev/apikey) — optional, enables owned-games sync.
STEAM_API_KEY=
# Featured listings. Leave PAYMENT_PROVIDER empty to pick automatically:
# Flouci if its keys are set, then Konnect, then a local test checkout (development only).
PAYMENT_PROVIDER=
# Flouci (https://docs.flouci.com): keys of your app; use the TEST APP keys while testing.
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=
# Konnect (https://docs.konnect.network): API key + the wallet that receives payments.
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_SANDBOX=true
LOG_LEVEL=info
# Dev seed accounts (npm run seed). Local only.
SEED_ADMIN_PASSWORD=tghub-admin-dev
SEED_PLAYER_PASSWORD=tghub-player-dev
SEED_FETCH_FEEDS=true
